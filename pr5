op = int(input("Enter The Number Of Nodes: "))
dll = Nodelist()

for i in range(op):
    d = int(input("Enter Data: "))
    dll.insert(d)

dll.traverse()
dll.trav_reverse()

print("------Insert Before-------")
dll.insertbefore(5, 20)
dll.traverse()

print("------Insert After-------")
dll.insertafter(35, 30)
dll.traverse()

print("------Delete First-------")
dll.deletefirst()
dll.traverse()

print("------Delete Last-------")
dll.deletelast()
dll.traverse()

print("-----Delete Any (All Occurrences)--------")
dll.deletespecific(5)
dll.traverse()
