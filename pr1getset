class Product:
    def __init__(self, product_id, product_name, price, stock):
        self.product_id = product_id
        self.product_name = product_name
        self.price = price
        self.stock = stock

    # Accessor methods
    def get_product_id(self):
        return self.product_id

    def get_product_name(self):
        return self.product_name

    def get_price(self):
        return self.price

    def get_stock(self):
        return self.stock

    # Mutator methods
    def set_price(self, price):
        self.price = price

    def set_stock(self, stock):
        self.stock = stock


class Customer:
    def __init__(self, customer_id, name):
        self.customer_id = customer_id
        self.name = name

    # Accessor methods
    def get_customer_id(self):
        return self.customer_id

    def get_name(self):
        return self.name

    # Mutator methods
    def set_name(self, name):
        self.name = name

    # Purchase product method
    def purchase_product(self, product):
        if product.get_stock() > 0:
            product.set_stock(product.get_stock() - 1)
            print(self.name, "purchased", product.get_product_name())
            print("Remaining stock:", product.get_stock())
        else:
            print("Product is out of stock")


# Creating Product object
p1 = Product(101, "Laptop", 50000, 5)

# Creating Customer object
c1 = Customer(1, "Mujeeb")

# Purchase
c1.purchase_product(p1)
